{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pporlock.local/schemas/flow.schema.json",
  "title": "FlowRecord",
  "description": "The persisted and API-exposed representation of one flow (SPEC-0 \u00a73.4). This shape appears in GET /flows, in session storage, in the SSE stream, and in MCP output.",
  "type": "object",
  "required": [
    "flow_id",
    "kind",
    "started_at",
    "modified",
    "blocked",
    "provenance",
    "redacted"
  ],
  "additionalProperties": false,
  "properties": {
    "flow_id": {
      "type": "string",
      "description": "ULID, monotonic and sortable"
    },
    "kind": {
      "type": "string",
      "enum": [
        "http",
        "websocket",
        "passthrough"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tab_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Chrome tab. Null until attribution backfills it, and may stay null \u2014 every consumer must tolerate that (SPEC-0 \u00a73.6)"
    },
    "request": {
      "$ref": "#/$defs/flow_request"
    },
    "response": {
      "anyOf": [
        {
          "$ref": "#/$defs/flow_response"
        },
        {
          "type": "null"
        }
      ]
    },
    "websocket": {
      "anyOf": [
        {
          "$ref": "#/$defs/flow_websocket"
        },
        {
          "type": "null"
        }
      ]
    },
    "timing": {
      "anyOf": [
        {
          "$ref": "#/$defs/flow_timing"
        },
        {
          "type": "null"
        }
      ]
    },
    "modified": {
      "type": "boolean",
      "description": "Any header or body mutation was applied"
    },
    "blocked": {
      "type": "boolean",
      "description": "The client was denied the response it asked for \u2014 a `block` rule, by stub or by kill. NOT merely 'short-circuited': `map_local` and `redirect` also end request evaluation early, and both return a response the browser uses. See `short_circuit` for which action ended evaluation (OI-26)."
    },
    "provenance": {
      "$ref": "https://pporlock.local/schemas/provenance.schema.json"
    },
    "redacted": {
      "type": "boolean",
      "description": "Redaction was applied to this representation (REQ CAP-040)"
    },
    "passthrough": {
      "anyOf": [
        {
          "$ref": "#/$defs/flow_passthrough"
        },
        {
          "type": "null"
        }
      ],
      "description": "Present when kind is 'passthrough'. An excluded connection is tunneled undecrypted, so it has no request or response \u2014 but it must still be visible (REQ PXY-015)."
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "description": "Why the flow failed before completing \u2014 a connection refused, a TLS failure, a timeout. Present only when the proxy could not complete the exchange, in which case `response` is absent. Without this a 502 leaves no trace in the flow table at all, which is the one case a user most needs to see (OI-23).",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "The proxy's own description of the failure."
        },
        "from_client": {
          "type": "boolean",
          "description": "True when the client went away, false when the upstream did. A browser cancelling a request and an origin refusing one look identical in a count and are not the same event."
        }
      }
    },
    "short_circuit": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "block",
        "map_local",
        "redirect",
        null
      ],
      "description": "Which action ended request evaluation, if one did (REQ MOD-012). `map_local` means the response came from a module's assets and `redirect` that the request was sent elsewhere \u2014 both succeeded, and neither is a block."
    }
  },
  "$defs": {
    "header_pairs": {
      "type": "array",
      "description": "Ordered [name, value] pairs. Names lowercased; a list, not a map, because headers repeat (SPEC-0 \u00a72).",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "body_encoding": {
      "type": "string",
      "enum": [
        "utf8",
        "base64"
      ],
      "description": "Text bodies travel as UTF-8 strings for readability, binary as base64"
    },
    "flow_request": {
      "type": "object",
      "required": [
        "method",
        "scheme",
        "host",
        "port",
        "path",
        "url",
        "headers",
        "body_size"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string"
        },
        "query": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "url": {
          "type": "string"
        },
        "http_version": {
          "type": "string"
        },
        "dest": {
          "type": [
            "string",
            "null"
          ],
          "description": "Sec-Fetch-Dest, verbatim"
        },
        "headers": {
          "$ref": "#/$defs/header_pairs"
        },
        "body_size": {
          "type": "integer",
          "minimum": 0
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "Omitted at summary detail (SPEC-0 \u00a76.3)"
        },
        "body_encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/body_encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_truncated": {
          "type": "boolean"
        }
      }
    },
    "flow_response": {
      "type": "object",
      "required": [
        "status",
        "headers",
        "body_size",
        "streamed"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "http_version": {
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/header_pairs"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "Media type only, no parameters"
        },
        "body_size": {
          "type": "integer",
          "minimum": 0
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "body_encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/body_encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "body_truncated": {
          "type": "boolean"
        },
        "streamed": {
          "type": "boolean",
          "description": "Buffering guard declined; body transforms unavailable (REQ PXY-022)"
        }
      }
    },
    "flow_websocket": {
      "type": "object",
      "required": [
        "closed",
        "message_count"
      ],
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "close_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "Oldest frames discarded to keep the record within its retention bound (REQ CAP-003). Non-zero means this capture is a window on the socket, not the whole of it."
        },
        "messages": {
          "type": "array",
          "description": "Omitted at summary detail. Inspection-only in v1 (REQ PXY-051).",
          "items": {
            "$ref": "#/$defs/ws_message"
          }
        }
      }
    },
    "ws_message": {
      "type": "object",
      "required": [
        "index",
        "timestamp",
        "direction",
        "opcode",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "direction": {
          "type": "string",
          "enum": [
            "outbound",
            "inbound"
          ]
        },
        "opcode": {
          "type": "string",
          "enum": [
            "text",
            "binary"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload_encoding": {
          "anyOf": [
            {
              "$ref": "#/$defs/body_encoding"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "flow_timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dns_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "connect_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "request_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "upstream_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "response_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "pporlock_ms": {
          "type": [
            "number",
            "null"
          ],
          "description": "Total time spent in our pipeline"
        },
        "total_ms": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "flow_passthrough": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": [
            "string",
            "null"
          ],
          "description": "SNI, when the client sent one"
        },
        "ip": {
          "type": [
            "string",
            "null"
          ],
          "description": "Destination IP, the no-SNI fallback"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exclusion entry that matched"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "That entry's comment \u2014 why the exclusion exists"
        }
      }
    }
  }
}
