        "name": "corpus-injector",
        "files": {
          "module.yaml": "name: corpus-injector\nversion: 1.0.0\npporlock_api: \"1\"\nrules:\n  - name: strip the csp\n    action: headers\n    match:\n      host: app.example.test\n    response:\n      remove: [content-security-policy]\n  - name: inject the shim\n    action: body\n    match:\n      host: app.example.test\n      content_type: text/html\n    transform:\n      kind: inject_script\n      inline: window.__pporlock=1\n      position: head_end\n"
        }
      }
    ],
    "include_diffs": true
  },
