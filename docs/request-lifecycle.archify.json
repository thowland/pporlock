    "views": [
      {
        "id": "clienthello",
        "label": "Phase 1: exclusion",
        "focus": [
          "chrome",
          "addon",
          "engine"
        ],
        "note": "Before any byte is decrypted, the SNI is checked against the exclusion list. Excluded hosts are tunneled and recorded as passthrough."
      },
      {
        "id": "request",
        "label": "Phases 2-3: request",
        "focus": [
          "chrome",
          "addon",
          "engine",
          "origin"
        ],
        "note": "Short-circuit rules run first; the first match wins and the origin is never contacted. Header rules follow."
      },
      {
        "id": "headers",
        "label": "Phases 4-5: buffering",
        "focus": [
          "origin",
          "addon",
          "engine"
        ],
        "note": "Header mutations and the stream-or-buffer decision must both happen before mitmproxy puts headers on the wire."
      },
      {
        "id": "body",
        "label": "Phase 6: body",
        "focus": [
          "origin",
          "addon",
          "engine",
          "chrome"
        ],
        "note": "Body transforms run only on buffered responses, inside a per-flow time budget, offloaded to a thread when heavy."
      },
      {
        "id": "record",
        "label": "Record and publish",
        "focus": [
          "addon",
          "capture",
          "control"
        ],
        "note": "The flow that actually happened, with its provenance, lands in the ring and fans out to every reader."
      }
    ]
