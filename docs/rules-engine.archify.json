        "note": "module.yaml and rules.yaml are parsed strictly, then every rule becomes a CompiledRule with a pre-compiled matcher and validated params."
      },
      {
        "id": "python",
        "label": "The Python tier",
        "focus": [
          "python",
          "loader",
          "registry",
          "context",
          "transforms",
          "evaluator"
        ],
        "note": "module.py is imported at load; its hooks run through a per-module ModuleContext and may register new transforms."
      },
      {
        "id": "assemble",
        "label": "Assembling the active set",
        "focus": [
          "loader",
          "sidecar",
          "registry",
          "ruleset"
        ],
        "note": "Loaded, enabled, not quarantined, in the active profile. File rules and module rules become one phase-partitioned RuleSet."
      },
      {
        "id": "evaluate",
        "label": "Per-flow evaluation",
        "focus": [
          "ruleset",
          "context",
          "transforms",
          "evaluator",
          "provenance"
        ],
        "note": "Six phases in fixed order; declarative rules first, then hooks; every outcome recorded."
      }
